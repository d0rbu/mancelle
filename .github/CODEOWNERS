# CODEOWNERS — see https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-policies/about-code-owners
#
# Default: maintainer reviews every change. The maintainer wants eyes on
# all implementation, configs, runners, and docs that reflect design.
# Each exemption below is a deliberate "this is high-churn / scratch /
# generated and gating it would just add review noise" call.
#
# Pattern matching: last matching line wins.

# ---- default ----------------------------------------------------------------
# Implementation, configs, runners, top-level docs, project meta.
# (nanochat/ is vendored; the do-not-modify policy is in nanochat/VENDORED.md.)
*                            @d0rbu

# ---- exemptions -------------------------------------------------------------

# High-churn code: SFT task definitions and the test suite.
tasks/
tests/

# Scratch / experimental: ad-hoc notebooks, leaderboards, in-progress notes.
dev/

# Plotting / visualization code — produces charts, not pipeline behavior.
viz/

# Local tooling: machine-specific settings, dynamically-loaded skills, etc.
.claude/

# Small references that are read but rarely changed in a meaningful way.
.env.example

# Auto-regenerated by `uv sync`; the meaningful intent lives in pyproject.toml.
uv.lock
