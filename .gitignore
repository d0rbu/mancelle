# issue #529: committed byte-identity golden anchors (tiny) must be tracked despite *.safetensors
!tests/scripts/golden/**/*.safetensors

# issue #531 packed-rows golden anchor (byte-identity gate) — force past *.safetensors/*.zst ignores
!tests/scripts/golden/packed_rows/
!tests/scripts/golden/packed_rows/*.safetensors.zst
