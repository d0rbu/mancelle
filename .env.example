# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ---- Required for the standard pipeline ----

# Where checkpoints, tokenizer artifacts, and downloaded data live.
# Leave unset to use the code default (<repo_root>/nanochat_cache, see
# nanochat.common.get_base_dir()). Set to an absolute path to override.
NANOCHAT_BASE_DIR=

# Hugging Face token — needed to download Gemma weights and GemmaScope SAEs.
# Create at https://huggingface.co/settings/tokens (read access is enough).
# Alternative: run `huggingface-cli login` once instead of setting this.
HF_TOKEN=hf_your_token_here

# ---- Optional, but expected by various scripts ----

# Weights & Biases — used by training scripts when `run` is not "dummy".
# Alternative: run `wandb login` once instead of setting this.
WANDB_API_KEY=

# OpenRouter — used by LLM-as-judge evals (steering_eval, harmfulness_eval, AxBench).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Neuronpedia — used for SAE feature interpretation / labels.
# Get one at https://www.neuronpedia.org/
NEURONPEDIA_API_KEY=
